  <script>
    // 넓은 화면(1024px 이상)의 오른쪽 목차에만 지금 읽는 구역을 표시해요.
    // 모바일은 그냥 링크 목록이에요. 스크립트가 없으면 표시만 빠지고 링크는 그대로 움직여요.
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    const wide = window.matchMedia('(min-width: 1024px)');
    if (toc && 'IntersectionObserver' in window) {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      const sections = links
        .map((a) => document.getElementById(a.dataset.tocLink!))
        .filter((el): el is HTMLElement => el !== null);
      const visible = new Set<string>();

      const setActive = (id: string | undefined) => {
        links.forEach((a) => {
          if (a.dataset.tocLink === id) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };

      const update = () => {
        if (!wide.matches) return setActive(undefined);
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
        if (atBottom) return setActive(sections[sections.length - 1]?.id);
        const first = sections.find((s) => visible.has(s.id));
        if (first) setActive(first.id);
        else if (window.scrollY < 40) setActive(undefined);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
          update();
        },
        // 화면 위쪽(머리글 아래 ~ 화면 절반 지점)에 걸친 구역을 「지금 읽는 곳」으로 봐요
        { rootMargin: '-72px 0px -50% 0px' }
      );
      let observing = false;
      const sync = () => {
        if (wide.matches && !observing) { sections.forEach((s) => io.observe(s)); observing = true; }
        else if (!wide.matches && observing) { io.disconnect(); visible.clear(); observing = false; }
        update();
      };
      wide.addEventListener('change', sync);
      sync();
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking || !wide.matches) return;
        ticking = true;
        requestAnimationFrame(() => { ticking = false; update(); });
      }, { passive: true });
    }
  </script>
