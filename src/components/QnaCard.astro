---
/** 「💬 비슷한 증상, 궁금한 점이 있으신가요? / 질문 남기기 →」 카드. 블로그 글과 용어 페이지가 같이 써요. */
interface Props {
  href?: string;
}
const { href = '/qna/' } = Astro.props;
---

<a
  href={href}
  data-ga="qna_card"
  data-ga-event="qna_card_click"
  class="flex-1 flex items-center gap-3 p-4 rounded-xl border border-gray-200 bg-gray-50 hover:bg-gray-100 hover:border-gray-300 transition-all group"
>
  <span class="text-2xl">💬</span>
  <div class="min-w-0">
    <p class="text-xs text-gray-500 mb-0.5">비슷한 증상, 궁금한 점이 있으신가요?</p>
    <p class="text-sm font-bold text-gray-900 group-hover:text-brand transition-colors">질문 남기기 →</p>
  </div>
</a>
