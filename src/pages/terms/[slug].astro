---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { doctorWVoiceGuide } from '../../data/doctorWVoice';
import { parseDetail, splitSentences, sentenceBullets, sourceUrl, sourceTitle, sourceHost } from '../../lib/termSections';
import type { TermCite } from '../../lib/termSections';
import CiteMark from '../../components/CiteMark.astro';
import { termCategoryBySlug } from '../../data/termCategories';
import { termCategoryOverrideBySlug } from '../../data/termGuideBlocks';

export const getStaticPaths = (async () => {
  const terms = await getCollection('terms');
  return terms.map((term) => ({
    params: { slug: term.data.termSlug },
    props: { term },
  }));
}) satisfies GetStaticPaths;

const { term } = Astro.props;
const publicSlug = term.data.termSlug;

/**
 * aliases는 블로그 태그에서 뽑은 검색 키워드라 "레진가격" 같은 검색어와
 * "충치 → 법랑질" 처럼 다른 개념까지 섞여 있다. 검색에만 쓰고,
 * 화면과 alternateName에는 선별한 synonyms만 내보낸다.
 */
const synonymList = (term.data.synonyms ?? []).filter((a) => a !== term.data.name);
const alternateNames = [term.data.en, ...synonymList].filter(Boolean);

/** 치료 블록이 가리키는 시술 페이지의 표제어 — CTA에 목적지 이름을 쓰기 위함 */
const approachSlugs = term.data.approach.map((a) => a.slug).filter(Boolean) as string[];
const approachNameBySlug = Object.fromEntries(
  (
    await Promise.all(approachSlugs.map((s) => getEntry('terms', `term-${s}`)))
  )
    .filter(Boolean)
    .map((e) => [e!.data.termSlug, e!.data.name])
);

const relatedTermEntries = (
  await Promise.all(
    term.data.relatedTerms.map((slug) => getEntry('terms', `term-${slug}`))
  )
).filter(Boolean);

const description =
  term.data.definition.length > 155
    ? term.data.definition.slice(0, 152).replace(/\s\S*$/, '') + '…'
    : term.data.definition;

/**
 * 본문에 「## 소제목」이 있는 용어(시범 용어)는 소제목 구역으로 나눠 보여 주고,
 * 없는 용어는 지금까지처럼 한 덩어리로 보여 준다.
 */
const parsed = parseDetail(term.data.detail);
const sections = parsed.hasSections ? parsed.sections : [];
const hasSections = sections.length > 0;

/** 참고 자료는 글자 주소와 {url, title}를 모두 받는다 */
const sourceItems = term.data.sources.map((s) => ({
  url: sourceUrl(s),
  title: sourceTitle(s),
}));

/** 소제목 용어 전용: 분야(초안)·안내 상자·표·질문 카드 */
const category = hasSections ? (termCategoryOverrideBySlug[publicSlug] ?? termCategoryBySlug[publicSlug]) : undefined;
const numbered = sections.map((sec, i) => ({ sec, n: i + 1 }));
const plainSections = numbered.filter((x) => !x.sec.callout);
const calloutSections = numbered.filter((x) => x.sec.callout);
const compare = hasSections ? term.data.compare : undefined;
const askCards = hasSections ? term.data.askCards : [];
const pad2 = (n: number) => String(n).padStart(2, '0');

/**
 * 각주: 화면에 나오는 차례(소제목 구역 → 안내 상자 → 질문 카드)대로 처음 나온 순서로 번호를 매기고,
 * 같은 출처는 같은 번호를 다시 써요. 참고 자료 목록도 이 번호 순서이고, 본문에서 안 쓴 출처는 뒤에 이어 붙여요.
 */
const refTitleByUrl = new Map<string, string>(
  sourceItems.map((s) => [s.url, s.title ?? sourceHost(s.url)])
);
const citeOrder: string[] = [];
const citeCount = new Map<string, number>();
function plan(url: string, label: string) {
  if (!refTitleByUrl.has(url)) refTitleByUrl.set(url, label);
  let idx = citeOrder.indexOf(url);
  if (idx < 0) {
    citeOrder.push(url);
    idx = citeOrder.length - 1;
  }
  const k = (citeCount.get(url) ?? 0) + 1;
  citeCount.set(url, k);
  return { n: idx + 1, k, url };
}
const mk = (c: TermCite) => plan(c.url, c.label);
type Mark = ReturnType<typeof plan>;
const sectionRender = new Map<
  number,
  {
    paras: { text: string; cite?: Mark }[][];
    bullets: { sentence: string; cites: Mark[] }[];
  }
>();
if (hasSections) {
  for (const { sec, n } of [...plainSections, ...calloutSections]) {
    sectionRender.set(n, {
      paras: sec.callout ? [] : sec.pieces.map((ps) => ps.map((p) => ({ text: p.text, cite: p.cite ? mk(p.cite) : undefined }))),
      bullets: sec.callout
        ? sec.pieces.flatMap((ps) => sentenceBullets(ps)).map((b) => ({ sentence: b.sentence, cites: b.cites.map(mk) }))
        : [],
    });
  }
}
const askRender = askCards.map((card) => {
  const sentences = splitSentences(card.explanation);
  const k = Math.min(Math.max(card.citeAfter ?? sentences.length, 1), sentences.length);
  return {
    before: sentences.slice(0, k).join(' '),
    after: sentences.slice(k).join(' '),
    cite: card.sourceUrl ? plan(card.sourceUrl, card.sourceLabel) : undefined,
  };
});
const refList = hasSections
  ? [
      ...citeOrder,
      ...sourceItems.map((s) => s.url).filter((u) => !citeOrder.includes(u)),
    ].map((url) => ({ url, title: refTitleByUrl.get(url) ?? sourceHost(url), cited: citeOrder.includes(url) }))
  : [];
const refName = (url: string) => (refTitleByUrl.get(url) ?? sourceHost(url)).split(/[:：]/)[0].trim();
const formatDate = (d: string) => d.replace(/-/g, '. ') + '.';

/** 목차: 화면에 실제로 나오는 구역만 */
const tocItems = hasSections
  ? [
      ...plainSections.slice(0, 1).map(({ sec, n }) => ({ id: `sec-${n}`, label: sec.heading })),
      ...(compare ? [{ id: 'compare', label: compare.title }] : []),
      ...plainSections.slice(1).map(({ sec, n }) => ({ id: `sec-${n}`, label: sec.heading })),
      ...(term.data.approach.length > 0 ? [{ id: 'approach', label: '치료 방법' }] : []),
      ...calloutSections.map(({ sec, n }) => ({ id: `sec-${n}`, label: sec.heading })),
      ...(askCards.length > 0 ? [{ id: 'ask', label: '진료실에서 물어볼 것' }] : []),
      ...(term.data.faqs.length > 0 ? [{ id: 'faq', label: '자주 묻는 질문' }] : []),
      ...(relatedTermEntries.length > 0 ? [{ id: 'related-terms', label: '함께 보면 좋은 용어' }] : []),
      ...(term.data.relatedPosts.length > 0 ? [{ id: 'related-posts', label: '더 읽어보기' }] : []),
      ...(sourceItems.length > 0 ? [{ id: 'sources', label: '참고 자료' }] : []),
    ]
  : [
      { id: 'definition', label: '뜻과 설명' },
      ...(term.data.approach.length > 0 ? [{ id: 'approach', label: '치료 방법' }] : []),
      ...(term.data.faqs.length > 0 ? [{ id: 'faq', label: '자주 묻는 질문' }] : []),
      ...(relatedTermEntries.length > 0 ? [{ id: 'related-terms', label: '함께 보면 좋은 용어' }] : []),
      ...(term.data.relatedPosts.length > 0 ? [{ id: 'related-posts', label: '관련 블로그 글' }] : []),
      ...(sourceItems.length > 0 ? [{ id: 'sources', label: '참고 자료' }] : []),
    ];

const askSearchUrl = `/ask/?q=${encodeURIComponent(term.data.name)}`;

const definedTermLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.data.name,
  // 영문명과 동의어를 모두 실어 다른 표현으로 물어도 같은 항목으로 잡히게 한다
  ...(alternateNames.length ? { alternateName: alternateNames } : {}),
  description: term.data.definition,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: '윤원장의 치과사전',
    url: new URL('/terms/', Astro.site).href,
  },
  inLanguage: 'ko',
  ...(term.data.sources.length ? { citation: sourceItems.map((s) => s.url) } : {}),
  ...((term.data.reviewed ?? term.data.updated) ? { dateModified: term.data.reviewed ?? term.data.updated } : {}),
});
---

<BaseLayout
  title={term.data.seoTitle ?? (term.data.en ? `${term.data.name} (${term.data.en})` : term.data.name)}
  publishedDate={term.data.updated ? new Date(term.data.updated) : undefined}
  reviewedDate={term.data.reviewed ? new Date(term.data.reviewed) : undefined}
  medicalWebPage={true}
  description={description}
  type="article"
  tags={[term.data.name, ...synonymList]}
  faqSchema={term.data.faqs}
  breadcrumbs={[
    { name: '홈', url: '/' },
    { name: '치과사전', url: '/terms/' },
    { name: term.data.name, url: `/terms/${publicSlug}/` },
  ]}
>
  <script type="application/ld+json" set:html={definedTermLd} />

  <article>
    <!-- 상단 헤더: 표제어 → 한 줄 답 -->
    <header class="bg-gradient-to-b from-brand-bg to-white pt-6 md:pt-12 pb-4 md:pb-8">
      <div class="max-w-3xl lg:max-w-5xl mx-auto px-4 sm:px-6 anim-fade-up">
        <div class="lg:pr-[16.5rem]">
          <nav class="text-sm text-gray-500 mb-3 md:mb-5">
            <a href="/terms/" class="hover:text-brand transition-colors">치과사전</a>
            {category && (
              <>
                <span aria-hidden="true" class="mx-1">›</span>
                <b class="font-semibold text-brand-dark">{category}</b>
              </>
            )}
          </nav>
          {category && (
            <span class="inline-block mb-1 rounded-full border border-brand/30 bg-white px-2.5 py-0.5 text-xs font-semibold text-brand-dark">{category}</span>
          )}

          <h1 class="text-[1.75rem] md:text-4xl font-extrabold text-gray-900 leading-tight tracking-tight">{term.data.name}</h1>
          {term.data.en && (
            <p class="mt-1 text-base md:text-lg font-medium text-brand/80 tracking-wide">
              {term.data.en}
            </p>
          )}
          {synonymList.length > 0 && (
            <p class="mt-2 text-xs text-gray-400 leading-relaxed">
              <span class="font-medium text-gray-500 mr-1.5">{hasSections ? '같은 말' : '동의어'}</span>
              {synonymList.slice(0, 8).join(' · ')}
            </p>
          )}

          <p data-speakable class="mt-4 md:mt-6 text-lg md:text-xl font-bold text-gray-900 leading-[1.65]">
            <span class="bg-[linear-gradient(transparent_55%,rgba(253,224,71,0.55)_55%)] box-decoration-clone">
              {term.data.definition}
            </span>
          </p>

          {hasSections && (
            <dl class="mt-5 overflow-hidden rounded-[14px] border border-gray-200 bg-white text-[13.5px]">
              {category && (
                <div class="flex px-3.5 py-2.5"><dt class="w-[84px] flex-none text-gray-500">분야</dt><dd class="font-medium text-gray-900">{category}</dd></div>
              )}
              {term.data.en && (
                <div class="flex border-t border-gray-100 px-3.5 py-2.5"><dt class="w-[84px] flex-none text-gray-500">영문</dt><dd class="font-medium text-gray-900">{term.data.en}</dd></div>
              )}
              {synonymList.length > 0 && (
                <div class="flex border-t border-gray-100 px-3.5 py-2.5"><dt class="w-[84px] flex-none text-gray-500">같은 말</dt><dd class="font-medium text-gray-900">{synonymList.slice(0, 8).join(' · ')}</dd></div>
              )}
              {term.data.updated && (
                <div class="flex border-t border-gray-100 px-3.5 py-2.5"><dt class="w-[84px] flex-none text-gray-500">처음 정리</dt><dd class="font-medium text-gray-900">{formatDate(term.data.updated)}</dd></div>
              )}
              <div class="flex border-t border-gray-100 px-3.5 py-2.5"><dt class="w-[84px] flex-none text-gray-500">감수</dt><dd class="font-medium text-gray-900">{term.data.reviewed ? formatDate(term.data.reviewed) : '예정'}</dd></div>
            </dl>
          )}
        </div>
      </div>
    </header>

    <div class="max-w-3xl lg:max-w-5xl mx-auto px-4 sm:px-6 pt-1 md:pt-4 pb-10 md:pb-12 lg:grid lg:grid-cols-[minmax(0,1fr)_13.5rem] lg:gap-x-12">
      <!-- 목차: 모바일은 한 줄 답 바로 아래 촘촘한 세로 목록(줄 간격 26px, 누름 영역 32px, 표시 없음), 넓은 화면은 블로그 글 목차와 같은 모양(회색 작은 글, 왼쪽 가는 선, 읽는 곳은 브랜드색 굵게)으로 오른쪽에 붙어 따라와요. 누름 영역은 40px(위아래 7px 겹침) -->
      <nav
        aria-label="목차"
        data-toc
        class="mb-6 lg:mb-0 lg:col-start-2 lg:row-start-1 lg:self-start lg:sticky lg:top-24 rounded-xl border border-brand/15 bg-brand-bg/80 p-1.5 text-sm lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
      >
        <p class="px-2.5 pt-1.5 pb-0.5 text-sm font-bold text-gray-900 lg:p-0 lg:mb-3 lg:text-xs lg:text-gray-400 lg:uppercase lg:tracking-wider">목차</p>
        <ol class="pb-0.5 lg:pb-0 lg:space-y-1.5 lg:text-[0.8rem] lg:leading-snug lg:border-l-2 lg:border-gray-100 lg:pl-3">
          {tocItems.map((item) => (
            <li class="flow-root">
              <a
                href={`#${item.id}`}
                data-toc-link={item.id}
                class="relative flex items-center min-h-8 -my-[3px] px-2.5 rounded-lg text-gray-600 transition-colors hover:text-gray-900 hover:bg-white/60 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-dark lg:min-h-10 lg:-my-[7px] lg:px-0 lg:py-1 lg:rounded-sm lg:text-gray-400 lg:hover:text-brand lg:hover:bg-transparent lg:aria-[current=location]:text-brand lg:aria-[current=location]:font-semibold"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
      {!hasSections && (
      <section id="definition" aria-labelledby="definition-heading" class="mb-10 md:mb-12 scroll-mt-20 anim-fade-up anim-delay-1">
        <h2 id="definition-heading" class="text-lg font-bold text-gray-900 mb-3">뜻과 설명</h2>
        <div class="rounded-2xl bg-gray-50/70 border border-gray-100/90 px-5 py-5 md:px-7 md:py-6">
          <div class="space-y-4 text-gray-700 leading-relaxed text-[15px] md:text-base">
            {term.data.detail.split('\n\n').filter(Boolean).map((paragraph) => (
              <p>{paragraph.trim()}</p>
            ))}
          </div>
        </div>
      </section>
      )}

      {hasSections && plainSections.map(({ sec, n }, idx) => (
        <>
          <section aria-labelledby={`sec-${n}`} class="mb-10 md:mb-12 anim-fade-up anim-delay-1">
            <h2 id={`sec-${n}`} class="scroll-mt-20 text-[1.2rem] md:text-[1.3rem] font-bold text-gray-900 leading-snug mb-3">{sec.heading}</h2>
            <div class="space-y-4 text-gray-800 text-base leading-[1.75]">
              {sectionRender.get(n)!.paras.map((para) => (
                <p>{para.map((piece) => (<>{piece.text}{piece.cite && <CiteMark n={piece.cite.n} k={piece.cite.k} name={refName(piece.cite.url)} />}</>))}</p>
              ))}
            </div>
          </section>
          {idx === 0 && compare && (
            <section aria-labelledby="compare" class="mb-10 md:mb-12 anim-fade-up anim-delay-1">
              <h2 id="compare" class="scroll-mt-20 text-[1.2rem] md:text-[1.3rem] font-bold text-gray-900 leading-snug mb-3">{compare.title}</h2>
              <div class="overflow-x-auto rounded-[14px] border border-gray-200">
                <table class="w-full border-collapse text-[13.5px]">
                  <thead>
                    <tr class="bg-gray-50">
                      <th class="w-[70px] border-b border-gray-200 px-2.5 py-2.5"></th>
                      {compare.columns.map((c) => (
                        <th class="border-b border-gray-200 px-2.5 py-2.5 text-left font-bold text-gray-900">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {compare.rows.map((row) => (
                      <tr>
                        <td class="whitespace-nowrap border-t border-gray-100 px-2.5 py-2.5 align-top text-gray-500">{row.label}</td>
                        {row.cells.map((cell) => (
                          <td class="border-t border-gray-100 px-2.5 py-2.5 align-top leading-normal text-gray-700">{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </>
      ))}

      {term.data.approach.length > 0 && (
        <section id="approach" class="mb-10 md:mb-12 scroll-mt-20 anim-fade-up anim-delay-2">
          <h2 class="text-lg font-bold text-gray-900 mb-1">치료 방법</h2>
          <p class="text-xs text-gray-400 mb-4">이렇게 치료합니다.</p>

          {term.data.approachOrdered && (
            <p class="mb-4 inline-flex items-center gap-1.5 rounded-lg bg-brand/5 px-3 py-1.5 text-xs font-medium text-brand/80">
              <span aria-hidden="true">↓</span>
              순서대로 진행합니다
            </p>
          )}

          <ol class="space-y-3" data-speakable>
            {term.data.approach.map((item, i) => {
              // 사전에 그 시술 페이지가 있을 때만 카드 전체를 링크로 만든다
              const Card = item.slug ? 'a' : 'div';
              const cardProps = item.slug
                ? {
                    href: `/terms/${item.slug}/`,
                    class:
                      'group block rounded-2xl border border-gray-100 bg-white p-5 hover:border-brand/40 hover:shadow-md transition-all',
                  }
                : { class: 'rounded-2xl border border-gray-100 bg-white p-5' };

              return (
                <li>
                  <Card {...cardProps}>
                    <div class="flex items-start gap-3">
                      <!-- 단계 표시처럼 보이지 않게 원형 배지 대신 목록 번호로 둔다 -->
                      <span class="flex-shrink-0 w-5 text-right text-sm font-bold text-gray-300 tabular-nums mt-px">
                        {i + 1}
                      </span>
                      <div class="min-w-0 flex-1">
                        <p class="text-xs text-gray-500 leading-relaxed">{item.when}</p>
                        <p class="mt-1.5 font-bold text-gray-900 leading-snug">
                          <span class={item.slug ? 'group-hover:text-brand transition-colors' : ''}>
                            {item.name}
                          </span>
                          {item.en && (
                            <span class="ml-2 text-xs font-medium text-brand/70 tracking-wide">
                              {item.en}
                            </span>
                          )}
                        </p>
                        <p class="mt-1.5 text-[15px] text-gray-600 leading-relaxed">{item.detail}</p>
                        {item.slug && approachNameBySlug[item.slug] && (
                          <span class="mt-2.5 inline-flex items-center gap-1 text-xs font-medium text-gray-400 group-hover:text-brand transition-colors">
                            {approachNameBySlug[item.slug]} 자세히 보기
                            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                          </span>
                        )}
                      </div>
                    </div>
                  </Card>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {calloutSections.map(({ sec, n }) => (
        <section aria-labelledby={`sec-${n}`} class="mb-10 md:mb-12 anim-fade-up anim-delay-2">
          <div class="rounded-[14px] border border-orange-200 bg-orange-50 px-3.5 py-3.5">
            <h2 id={`sec-${n}`} class="scroll-mt-20 text-[15px] font-bold leading-snug text-orange-800 mb-2">{sec.heading}</h2>
            <ul class="list-disc space-y-1 pl-5 text-[14.5px] leading-[1.6] text-orange-950 marker:text-orange-400">
              {sectionRender.get(n)!.bullets.map((b) => (
                <li>{b.sentence}{b.cites.map((c) => <CiteMark n={c.n} k={c.k} name={refName(c.url)} />)}</li>
              ))}
            </ul>
          </div>
        </section>
      ))}

      {askCards.length > 0 && (
        <section id="ask" class="mb-10 md:mb-12 scroll-mt-20 anim-fade-up anim-delay-2">
          <p class="text-xs font-bold tracking-wide text-brand-dark">이해 가이드</p>
          <h2 class="mt-1 text-[1.2rem] md:text-[1.3rem] font-bold text-gray-900 leading-snug">진료 받을 때 이렇게 물어보세요</h2>
          <p class="mt-1 mb-3 text-[13.5px] leading-normal text-gray-500">내 상태에 맞는 설명을 듣는 데 도움이 되는 질문이에요.</p>
          {askCards.map((card, i) => (
            <div class="border-t border-gray-200 pt-3.5 pb-1">
              <p class="text-xs font-bold text-brand-dark">질문 {i + 1}</p>
              <h3 class="mt-1 mb-2.5 text-base font-bold leading-snug text-gray-900">{card.question}</h3>
